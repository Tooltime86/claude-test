{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "your_github_token_here"
      },
      "description": "GitHub MCP server for repository operations",
      "capabilities": [
        "browse_repositories",
        "read_files",
        "create_files",
        "commit_changes",
        "push_changes"
      ]
    }
  },
  "settings": {
    "autoConnect": true,
    "defaultBranch": "main",
    "commitSignoff": false
  },
  "security": {
    "requireApproval": true,
    "allowedRepositories": [
      "owner/repo-name"
    ],
    "restrictedOperations": [
      "force_push",
      "delete_branch"
    ]
  }
}
